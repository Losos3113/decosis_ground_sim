# --- pozemni stanice ---
SIMULATOR_PORT=8002

# Vstup: multicast MPEG-2 TS (STANAG 4609 / MISB ST 0601)
SRC=239.1.1.1
SRC_PORT=5000
IFACE=

# 1:1 preposlani syroveho TS dal (retransmitter.py) - beze zmeny
RETRANSMIT_DST=239.1.1.2
RETRANSMIT_DST_PORT=5000

# SNAPSHOT kanal: kam POSTovat snimky (multipart: cast metadata + cast image).
# Pro lokalni test: python3 testing/mock_api.py --port 9000
SNAPSHOT_API_URL=http://127.0.0.1:9000/snapshot
SNAPSHOT_API_TIMEOUT_MS=2000
SNAPSHOT_API_TOKEN=

# Druhy cil: zakaznicke API. Pise ho zakaznik, ne my - proto ma vlastni
# jmeno v konfiguraci i v logu ([SEND:customer]), aby pri vypadku bylo hned
# videt, ci strana je nedostupna. Cile jsou uplne nezavisle: pomaly nebo
# spadly zakaznicky endpoint neovlivni ani nas vlastni kanal, ani dekodovani.
# Prazdne = posila se jen na SNAPSHOT_API_URL.
TARGET_API_URL=
# {uav} v URL se nahradi hodnotou GROUND_SIM_UAV, takze
#   http://10.0.0.5/path/to/{uav}/  ->  http://10.0.0.5/path/to/uav1/
# Muze byt kdekoli v ceste, treba /{uav}/snapshots. Bez nej se URL nemeni.
TARGET_API_TIMEOUT_MS=2000
TARGET_API_TOKEN=

# Ukladani na disk - ke kazdemu snimku .jpg + .json. Prazdne = neuklada se.
# POZOR na kapacitu: pri 1 zprave za sekundu a ~75 kB na JPEG narusta slozka
# zhruba o 290 MB za hodinu (~7 GB/den). SNAPSHOT_SAVE_KEEP proto drzi jen
# poslednich N snimku a starsi maze; 0 = bez omezeni, uklid je pak na obsluze.
# SNAPSHOT_SAVE_DIR je cesta UVNITR kontejneru, SNAPSHOT_SAVE_DIR_HOST je
# slozka na hostu, ktera se na ni namountuje. Musi byt zapisovatelna pro
# uid 1000 - kontejner bezi pod grounduser.
SNAPSHOT_SAVE_DIR=/data/snapshots
SNAPSHOT_SAVE_DIR_HOST=./snapshots
SNAPSHOT_SAVE_KEEP=500

# Pozemni simulator (projekt decosis_ground_sim), odkud se dobira PX4
# telemetrie. Prazdne = snimky pojedou jen s KLV.
# Port 8001 je vychozi SIMULATOR_PORT z decosis_ground_sim/.env - pokud ho
# tam zmenis, zmen i tenhle radek, nic to mezi projekty neoveruje samo.
GROUND_SIM_URL=http://127.0.0.1:8002
GROUND_SIM_UAV=uav1
GROUND_SIM_POLL_S=1.0
GROUND_SIM_TIMEOUT_MS=1000
GROUND_SIM_MAX_AGE_S=10

# Prazdne = fps se zmeri automaticky z PTS streamu (doporuceno, nespoleha
# na znalost nastaveni kamery). Vyplnit jen pro rucni prepsani.
INPUT_FPS=
# 1-31 (nizsi = lepsi). Uz NEni svazane velikosti UDP datagramu - viz
# NAVRH_rest_output.md sekce 3.
JPEG_QUALITY=2

# Rychlost prehravani testovaciho videa (sluzba `replay`, jen s profilem).
# Vysilat rychleji nez realny bitrate souboru zrychli i cely prevod.
REPLAY_RATE=6M
# TTL multicastu - kolik smerovacu smi stream prejit. 1 = jen tenhle stroj.
REPLAY_TTL=8
# Slozka na hostu s .ts souborem k prehrani (sluzba `replay`).
REPLAY_VIDEO_DIR=./video

# Takt odesilani: kazdych tolik sekund odejde na KAZDY cil prave jedna zprava
# (snimek, nebo heartbeat). Prijemce podle ticha pozna vypadek, takze tahle
# hodnota je zaroven jeho casovy limit.
SEND_INTERVAL_S=1.0

# Ladici parametry prijmu - vychozi hodnoty staci. Prijmovy buffer zvedat,
# kdyz log hlasi ztraty paketu; horizont PTS, kdyz hlasi nedohledatelne PTS.
RECV_BUFFER_MB=8
PTS_HORIZON_S=30

# Nahradni prijemci (profil `mock`). Porty se musi shodovat s adresami
# v SNAPSHOT_API_URL a TARGET_API_URL vyse.
MOCK_API_PORT=9000
MOCK_TARGET_API_PORT=9100
# Kam nahradni prijemci ukladaji, co jim doslo (slozka na hostu), a kolik
# poslednich snimku si drzi. Hodi se na overeni, ze obrazky opravdu dorazily.
MOCK_API_SAVE_DIR=./received
MOCK_TARGET_SAVE_DIR=./received
MOCK_KEEP=20
